# Copy this file to .env, put your key in, and you're ready. Every setting the app reads is listed here.
# After changing .env, press reset in Webots (or restart run.py).

# Your Gemini API key(s), free from https://aistudio.google.com/apikey
# One key:  GOOGLE_API_KEY_VAULT='[AQ.your-key]'
# Several:  GOOGLE_API_KEY_VAULT='[AQ.key-1, AQ.key-2]'   (keys from different Google accounts; when one
#           runs out of its daily quota, the next is used)
GOOGLE_API_KEY_VAULT='[]'

# free = waits 13 s between Gemini calls to stay under the free limit (5 a minute); paid = no waiting
ROVER_API_TIER=free

# overhead = plan the whole route from the camera above the maze
# camera   = decide one move at a time from the robot's own front camera
ROVER_MODE=overhead

# The Gemini model and how hard it thinks (LOW, MEDIUM or HIGH; higher is slower)
ROVER_MODEL=gemini-robotics-er-2-preview
ROVER_THINKING=MEDIUM
